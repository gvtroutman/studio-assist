{
  "id": "zimage_hq",
  "label": "Z-Image Turbo high quality",
  "about": "Z-Image Turbo text to image (ComfyUI's own recipe) with model-only LoRAs, an optional source picture, and the upscale-and-refine detail pass the chat tab's bridge uses. A pose (OpenPose stick figure) and a composition (depth map) go through Alibaba PAI's Z-Image-Turbo Fun ControlNet Union, a model patch, depth chained after pose; unlike FLUX's ControlNet it patches the model, not the conditioning, so only the first pass samples with the patched model - the face pass and the refine pass keep node 4, unpatched, as a whole-frame map over a face crop would pull it out of shape. A part redrawn over what is there (a face, a hand, the eyes, a fixed spot) is sampled with `redraw_sampler` on `redraw_scheduler`, not the picture's own: a sampler that adds no noise of its own left specks and beads on skin at every strength, and of the clean ones euler_ancestral on beta keeps a face nearest; `face_denoise` 0.3 mends a small face's eyes and teeth and keeps more of the face than 0.4. `lora_budget` is the total LoRA weight this step-distilled model takes before its pictures break up, and `anatomy` false leaves the sentence that counts hands and fingers out of the prompt: it draws them well untold, and told, makes them the subject.",
  "families": ["z-image"],
  "anatomy": false,
  "defaults": {
    "steps": 8, "guidance": 1.0, "sampler": "res_multistep", "scheduler": "simple",
    "width": 1024, "height": 1024, "denoise": 1.0, "shift": 3.0,
    "encoder_device": "default", "refine": false, "upscale": 1.5,
    "refine_steps": 5, "refine_denoise": 0.33, "refine_sampler": "dpmpp_2m_sde",
    "refine_scheduler": "beta", "filename_prefix": "ImageStudio/zimage",
    "redraw_sampler": "euler_ancestral", "redraw_scheduler": "beta", "face_denoise": 0.3,
    "lora_budget": 1.2,
    "model_patch": "Z-Image-Turbo-Fun-Controlnet-Union-2.1-2602-8steps.safetensors",
    "pose_strength": 0.85, "composition_strength": 0.5
  },
  "source_denoise": 0.6,
  "files": {"model": "diffusion_models", "encoder": "text_encoders", "vae": "vae",
            "model_patch": "model_patches"},
  "needs": {"pose_image": ["model_patch"], "composition_image": ["model_patch"]},
  "references": {"pose": "pose_image", "composition": "composition_image",
                 "source": "source_image"},
  "lora_chain": {"model": ["1", 0]},
  "regional_conditioning": {
    "base_clip": "10",
    "positive_in": [["40", "positive"], ["44", "positive"]]
  },
  "switches": {
    "latent": {"when": "source_image", "then": ["22", 0], "else": ["20", 0]},
    "posed_model": {"when": "pose_image", "then": ["52", 0], "else": "{{model_out}}"},
    "controlled_model": {"when": "composition_image", "then": ["54", 0],
                         "else": "{{posed_model}}"},
    "sample_posed": {"when": "pose_image", "then": ["56", 0], "else": ["4", 0]},
    "sample_model": {"when": "composition_image", "then": ["56", 0],
                     "else": "{{sample_posed}}"},
    "final": {"when": "refine", "then": ["45", 0], "else": ["41", 0]}
  },
  "stages": {"refining": ["42", "43", "44", "45"]},
  "face_detail": {
    "model": ["4", 0], "vae": ["3", 0],
    "positive": ["f10", 0], "negative": ["f12", 0],
    "nodes": {
      "f10": {"class_type": "CLIPTextEncode",
              "inputs": {"text": "{{face_prompt}}", "clip": ["2", 0]}},
      "f12": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["f10", 0]}}
    }
  },
  "graph": {
    "1": {"class_type": "UNETLoader",
          "inputs": {"unet_name": "{{model}}", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader",
          "inputs": {"clip_name": "{{encoder}}", "type": "lumina2",
                     "device": "{{encoder_device}}"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},
    "4": {"class_type": "ModelSamplingAuraFlow",
          "inputs": {"model": "{{model_out}}", "shift": "{{shift}}"}},

    "10": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}},
    "12": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["10", 0]}},

    "50": {"_when": ["pose_image", "composition_image"], "class_type": "ModelPatchLoader",
           "inputs": {"name": "{{model_patch}}"}},
    "51": {"_when": "pose_image", "class_type": "LoadImage",
           "inputs": {"image": "{{pose_image}}"}},
    "52": {"_when": "pose_image", "class_type": "ZImageFunControlnet",
           "inputs": {"model": "{{model_out}}", "model_patch": ["50", 0], "vae": ["3", 0],
                      "strength": "{{pose_strength}}", "image": ["51", 0]}},
    "53": {"_when": "composition_image", "class_type": "LoadImage",
           "inputs": {"image": "{{composition_image}}"}},
    "54": {"_when": "composition_image", "class_type": "ZImageFunControlnet",
           "inputs": {"model": "{{posed_model}}", "model_patch": ["50", 0], "vae": ["3", 0],
                      "strength": "{{composition_strength}}", "image": ["53", 0]}},
    "56": {"_when": ["pose_image", "composition_image"], "class_type": "ModelSamplingAuraFlow",
           "inputs": {"model": "{{controlled_model}}", "shift": "{{shift}}"}},

    "20": {"_unless": "source_image", "class_type": "EmptySD3LatentImage",
           "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
    "21": {"_when": "source_image", "class_type": "LoadImage",
           "inputs": {"image": "{{source_image}}"}},
    "22": {"_when": "source_image", "class_type": "VAEEncode",
           "inputs": {"pixels": ["21", 0], "vae": ["3", 0]}},

    "40": {"class_type": "KSampler",
           "inputs": {"model": "{{sample_model}}", "seed": "{{seed}}", "steps": "{{steps}}",
                      "cfg": 1.0, "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}",
                      "positive": ["10", 0], "negative": ["12", 0],
                      "latent_image": "{{latent}}", "denoise": "{{denoise}}"}},
    "41": {"class_type": "VAEDecode", "inputs": {"samples": ["40", 0], "vae": ["3", 0]}},

    "42": {"_when": "refine", "class_type": "ImageScaleBy",
           "inputs": {"image": ["41", 0], "upscale_method": "lanczos",
                      "scale_by": "{{upscale}}"}},
    "43": {"_when": "refine", "class_type": "VAEEncodeTiled",
           "inputs": {"pixels": ["42", 0], "vae": ["3", 0], "tile_size": 1024,
                      "overlap": 128, "temporal_size": 64, "temporal_overlap": 8}},
    "44": {"_when": "refine", "class_type": "KSampler",
           "inputs": {"model": ["4", 0], "seed": "{{seed}}", "steps": "{{refine_steps}}",
                      "cfg": 1.0, "sampler_name": "{{refine_sampler}}",
                      "scheduler": "{{refine_scheduler}}", "positive": ["10", 0],
                      "negative": ["12", 0], "latent_image": ["43", 0],
                      "denoise": "{{refine_denoise}}"}},
    "45": {"_when": "refine", "class_type": "VAEDecodeTiled",
           "inputs": {"samples": ["44", 0], "vae": ["3", 0], "tile_size": 1024,
                      "overlap": 128, "temporal_size": 64, "temporal_overlap": 8}},

    "9": {"class_type": "SaveImage",
          "inputs": {"images": "{{final}}", "filename_prefix": "{{filename_prefix}}"}}
  }
}
