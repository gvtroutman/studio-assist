{
  "id": "qwen_image",
  "label": "Qwen-Image",
  "about": "Qwen-Image text to image, ComfyUI's own recipe: the 20B MMDiT (UNETLoader), Qwen2.5-VL 7B as its text encoder (CLIPLoader type qwen_image), its own VAE, ModelSamplingAuraFlow at shift 3.1, KSampler euler on simple at 20 steps and cfg 2.5 with a written negative, on an SD3 latent. Model-only LoRAs. A pose (OpenPose stick figure) goes through InstantX's Qwen-Image ControlNet Union (ComfyUI's own Qwen-Image InstantX ControlNet recipe: ControlNetLoader and ControlNetApplyAdvanced with the VAE) on the positive and negative, so the model is not patched and the face pass samples node 4 as the picture did. The face pass redraws each face crop on that model at the picture's own CFG with the written negative (`face_denoise`). Apache 2.0, so its pictures may be sold; a community checkpoint from the Checkpoints tab runs on this graph with its own file as `model`. No source picture, composition or refine pass yet.",
  "families": [
    "qwen-image"
  ],
  "defaults": {
    "steps": 20,
    "guidance": 2.5,
    "sampler": "euler",
    "scheduler": "simple",
    "width": 1328,
    "height": 1328,
    "shift": 3.1,
    "negative": "",
    "weight_dtype": "default",
    "encoder_device": "default",
    "filename_prefix": "ImageStudio/qwen",
    "controlnet": "Qwen-Image-InstantX-ControlNet-Union.safetensors",
    "pose_strength": 0.9,
    "pose_end": 0.6,
    "face_denoise": 0.4
  },
  "files": {
    "model": "diffusion_models",
    "encoder": "text_encoders",
    "vae": "vae",
    "controlnet": "controlnet"
  },
  "lora_chain": {
    "model": [
      "1",
      0
    ]
  },
  "stages": {
    "loading": [
      "1",
      "2",
      "3",
      "50",
      "51",
      "52"
    ],
    "sampling": [
      "40"
    ],
    "decoding": [
      "41",
      "9"
    ]
  },
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "{{model}}",
        "weight_dtype": "{{weight_dtype}}"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "{{encoder}}",
        "type": "qwen_image",
        "device": "{{encoder_device}}"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "{{vae}}"
      }
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": "{{model_out}}",
        "shift": "{{shift}}"
      }
    },
    "10": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "2",
          0
        ]
      }
    },
    "12": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "2",
          0
        ]
      }
    },
    "20": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "batch_size": 1
      }
    },
    "40": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "positive": "{{posed_positive}}",
        "negative": "{{posed_negative}}",
        "latent_image": [
          "20",
          0
        ],
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{guidance}}",
        "sampler_name": "{{sampler}}",
        "scheduler": "{{scheduler}}",
        "denoise": 1.0
      }
    },
    "41": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "40",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "41",
          0
        ],
        "filename_prefix": "{{filename_prefix}}"
      }
    },
    "50": {
      "_when": "pose_image",
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "{{controlnet}}"
      }
    },
    "51": {
      "_when": "pose_image",
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{pose_image}}"
      }
    },
    "52": {
      "_when": "pose_image",
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": [
          "10",
          0
        ],
        "negative": [
          "12",
          0
        ],
        "control_net": [
          "50",
          0
        ],
        "image": [
          "51",
          0
        ],
        "strength": "{{pose_strength}}",
        "start_percent": 0.0,
        "end_percent": "{{pose_end}}",
        "vae": [
          "3",
          0
        ]
      }
    }
  },
  "needs": {
    "pose_image": [
      "controlnet"
    ]
  },
  "references": {
    "pose": "pose_image"
  },
  "switches": {
    "posed_positive": {
      "when": "pose_image",
      "then": [
        "52",
        0
      ],
      "else": [
        "10",
        0
      ]
    },
    "posed_negative": {
      "when": "pose_image",
      "then": [
        "52",
        1
      ],
      "else": [
        "12",
        0
      ]
    }
  },
  "face_detail": {
    "model": [
      "4",
      0
    ],
    "vae": [
      "3",
      0
    ],
    "positive": [
      "f10",
      0
    ],
    "negative": [
      "12",
      0
    ],
    "cfg": "{{guidance}}",
    "nodes": {
      "f10": {
        "class_type": "CLIPTextEncode",
        "inputs": {
          "text": "{{face_prompt}}",
          "clip": [
            "2",
            0
          ]
        }
      }
    }
  }
}
