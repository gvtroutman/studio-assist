{
  "id": "klein9b_base",
  "label": "FLUX.2 Klein 9B",
  "about": "FLUX.2 [klein] base 9B text to image: the undistilled model a Build LoRA head LoRA is trained on, so an identity LoRA acts at full strength here (on the 4-step distilled 9B it barely shows; live on Partner, 2026-10-01). Real CFG with a written negative, 50 steps, ~40 s at 896x1152 on the 5090. Model-only LoRAs. A pose map is taken the way Klein takes any picture to edit from - as a reference latent (nodes 50-54, on both the positive and the negative), with `pose_words` before the prompt telling it to copy the stick figure's pose; Klein has no ControlNet, so a pose strength does not apply. No refine pass, face pass or source picture yet. Under the FLUX Non-Commercial License (the model's `license`).",
  "families": ["flux2-klein9b"],
  "defaults": {"steps": 50, "guidance": 4.0, "sampler": "euler", "width": 1024, "height": 1024,
               "negative": "", "encoder_device": "default", "filename_prefix": "ImageStudio/klein9b",
               "pose_words": "Apply the pose from image 1: the person's body, arms, legs and head are placed exactly as the stick figure in image 1 shows. Do not draw the stick figure."},
  "files": {"model": "diffusion_models", "encoder": "text_encoders", "vae": "vae"},
  "references": {"pose": "pose_image"},
  "lora_chain": {"model": ["1", 0]},
  "switches": {"positive": {"when": "pose_image", "then": ["53", 0], "else": ["10", 0]},
               "negative": {"when": "pose_image", "then": ["54", 0], "else": ["12", 0]}},
  "stages": {"loading": ["1", "2", "3", "50", "51", "52"], "sampling": ["40"], "decoding": ["41", "9"]},
  "graph": {
    "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{model}}", "weight_dtype": "default"}},
    "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{encoder}}", "type": "flux2", "device": "{{encoder_device}}"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},
    "10": {"_unless": "pose_image", "class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}},
    "13": {"_when": "pose_image", "class_type": "CLIPTextEncode", "inputs": {"text": "{{pose_words}} {{prompt}}", "clip": ["2", 0]}},
    "12": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative}}", "clip": ["2", 0]}},
    "50": {"_when": "pose_image", "class_type": "LoadImage", "inputs": {"image": "{{pose_image}}"}},
    "51": {"_when": "pose_image", "class_type": "ImageScaleToTotalPixels", "inputs": {"image": ["50", 0], "upscale_method": "nearest-exact", "megapixels": 1.0, "resolution_steps": 1}},
    "52": {"_when": "pose_image", "class_type": "VAEEncode", "inputs": {"pixels": ["51", 0], "vae": ["3", 0]}},
    "53": {"_when": "pose_image", "class_type": "ReferenceLatent", "inputs": {"conditioning": ["13", 0], "latent": ["52", 0]}},
    "54": {"_when": "pose_image", "class_type": "ReferenceLatent", "inputs": {"conditioning": ["12", 0], "latent": ["52", 0]}},
    "6": {"class_type": "CFGGuider", "inputs": {"model": "{{model_out}}", "positive": "{{positive}}", "negative": "{{negative}}", "cfg": "{{guidance}}"}},
    "20": {"class_type": "EmptyFlux2LatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
    "8": {"class_type": "Flux2Scheduler", "inputs": {"steps": "{{steps}}", "width": "{{width}}", "height": "{{height}}"}},
    "5": {"class_type": "RandomNoise", "inputs": {"noise_seed": "{{seed}}"}},
    "30": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "{{sampler}}"}},
    "40": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["5", 0], "guider": ["6", 0], "sampler": ["30", 0], "sigmas": ["8", 0], "latent_image": ["20", 0]}},
    "41": {"class_type": "VAEDecode", "inputs": {"samples": ["40", 0], "vae": ["3", 0]}},
    "9": {"class_type": "SaveImage", "inputs": {"images": ["41", 0], "filename_prefix": "{{filename_prefix}}"}}
  }
}
