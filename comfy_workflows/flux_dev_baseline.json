{
  "id": "flux_dev_baseline",
  "label": "FLUX.1 [dev]",
  "about": "The known-good FLUX.1 [dev] text to image: ComfyUI's own flux_dev_full_text_to_image recipe (split files, KSampler at CFG 1, zeroed negative) plus FluxGuidance, so guidance is a real setting. Layered on it, each off unless asked for, so with none of them on the graph is the baseline node for node: a LoRA stack (identity and style LoRAs), an upscale-and-refine pass at low denoise, and a face pass that redraws each face at full size with the same model and LoRAs.",
  "families": ["flux1"],
  "defaults": {
    "steps": 20, "guidance": 3.5, "sampler": "euler", "scheduler": "simple",
    "width": 1024, "height": 1024, "weight_dtype": "default",
    "encoder_device": "default", "filename_prefix": "ImageStudio/flux",
    "refine": false, "upscale": 1.5, "refine_steps": 14, "refine_denoise": 0.3,
    "refine_sampler": "euler", "refine_scheduler": "beta",
    "face_denoise": 0.4
  },
  "files": {
    "model": "diffusion_models", "clip_l": "text_encoders", "t5": "text_encoders",
    "vae": "vae"
  },
  "lora_chain": {"model": ["1", 0], "clip": ["2", 0]},
  "switches": {
    "final": {"when": "refine", "then": ["45", 0], "else": ["41", 0]}
  },
  "stages": {
    "loading": ["1", "2", "3", "10"],
    "sampling": ["40"],
    "decoding": ["41", "9"],
    "refining": ["42", "43", "44", "45"]
  },
  "face_detail": {
    "model": "{{model_out}}", "vae": ["3", 0],
    "positive": ["f11", 0], "negative": ["f12", 0],
    "nodes": {
      "f10": {"class_type": "CLIPTextEncode",
              "inputs": {"text": "{{face_prompt}}", "clip": "{{clip_out}}"}},
      "f11": {"class_type": "FluxGuidance",
              "inputs": {"conditioning": ["f10", 0], "guidance": "{{guidance}}"}},
      "f12": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["f10", 0]}}
    }
  },
  "graph": {
    "1": {"class_type": "UNETLoader",
          "inputs": {"unet_name": "{{model}}", "weight_dtype": "{{weight_dtype}}"}},
    "2": {"class_type": "DualCLIPLoader",
          "inputs": {"clip_name1": "{{clip_l}}", "clip_name2": "{{t5}}", "type": "flux",
                     "device": "{{encoder_device}}"}},
    "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},

    "10": {"class_type": "CLIPTextEncode",
           "inputs": {"text": "{{prompt}}", "clip": "{{clip_out}}"}},
    "11": {"class_type": "FluxGuidance",
           "inputs": {"conditioning": ["10", 0], "guidance": "{{guidance}}"}},
    "12": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["10", 0]}},

    "20": {"class_type": "EmptySD3LatentImage",
           "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},

    "40": {"class_type": "KSampler",
           "inputs": {"model": "{{model_out}}", "seed": "{{seed}}", "steps": "{{steps}}",
                      "cfg": 1.0, "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}",
                      "positive": ["11", 0], "negative": ["12", 0],
                      "latent_image": ["20", 0], "denoise": 1.0}},
    "41": {"class_type": "VAEDecode", "inputs": {"samples": ["40", 0], "vae": ["3", 0]}},

    "42": {"_when": "refine", "class_type": "ImageScaleBy",
           "inputs": {"image": ["41", 0], "upscale_method": "lanczos", "scale_by": "{{upscale}}"}},
    "43": {"_when": "refine", "class_type": "VAEEncodeTiled",
           "inputs": {"pixels": ["42", 0], "vae": ["3", 0], "tile_size": 1024, "overlap": 128,
                      "temporal_size": 64, "temporal_overlap": 8}},
    "44": {"_when": "refine", "class_type": "KSampler",
           "inputs": {"model": "{{model_out}}", "seed": "{{seed}}", "steps": "{{refine_steps}}",
                      "cfg": 1.0, "sampler_name": "{{refine_sampler}}",
                      "scheduler": "{{refine_scheduler}}", "positive": ["11", 0],
                      "negative": ["12", 0], "latent_image": ["43", 0],
                      "denoise": "{{refine_denoise}}"}},
    "45": {"_when": "refine", "class_type": "VAEDecodeTiled",
           "inputs": {"samples": ["44", 0], "vae": ["3", 0], "tile_size": 1024, "overlap": 128,
                      "temporal_size": 64, "temporal_overlap": 8}},

    "9": {"class_type": "SaveImage",
          "inputs": {"images": "{{final}}", "filename_prefix": "{{filename_prefix}}"}}
  }
}
